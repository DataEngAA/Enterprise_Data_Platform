# Copy this file to terraform.tfvars and fill in real values. terraform.tfvars
# is gitignored and must NEVER be committed.
#
# Requires bootstrap/main.tf's new deployment_shared_cost_controls_permissions
# policy to already be applied (the deployment role's permissions policy)
# before this configuration's provider/backend can do anything useful with
# deployment_role_arn below -- see README.md.
#
# No real account ID, ARN, or topic is set here -- placeholders only.

aws_account_id      = "<AWS_ACCOUNT_ID>"      # obtain with: aws sts get-caller-identity --query Account --output text
deployment_role_arn = "<DEPLOYMENT_ROLE_ARN>" # output of infrastructure/terraform/bootstrap's deployment_role_arn
sns_topic_arn        = "<SNS_TOPIC_ARN>"      # output of infrastructure/terraform/logging's security_alerts_topic_arn -- the EXISTING topic, not a new one

# project_name, environment, owner, cost_center, data_classification,
# budget_name, budget_limit_amount_usd, budget_actual_thresholds_usd, and
# budget_forecasted_threshold_usd all already default to the approved,
# finalized values in variables.tf -- override here only for a deliberate,
# reviewed change.

# additional_tags = {}
