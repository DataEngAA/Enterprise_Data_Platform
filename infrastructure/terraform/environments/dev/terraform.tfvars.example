# Copy this file to terraform.tfvars and fill in real values. terraform.tfvars
# is gitignored and must NEVER be committed.
#
# Requires Bootstrap Update 1 to have already landed (the deployment role's
# permissions policy, infrastructure/terraform/bootstrap/) before this
# configuration's provider/backend can do anything useful with
# deployment_role_arn below -- see README.md "Bootstrap Update 1 Dependency".
#
# No real account ID, ARN, or bucket name is set here -- placeholders only.

aws_account_id      = "<AWS_ACCOUNT_ID>"      # obtain with: aws sts get-caller-identity --query Account --output text
deployment_role_arn = "<DEPLOYMENT_ROLE_ARN>" # output of infrastructure/terraform/bootstrap's deployment_role_arn

# vpc_cidr and public_subnet_cidr already default to the approved, finalized
# values (10.20.0.0/16 / 10.20.1.0/24) in variables.tf -- override here only
# for a deliberate, reviewed change.
#
# The reserved private-application (10.20.11.0/24) and private-data
# (10.20.21.0/24) ranges are NOT Terraform variables -- removed 2026-07-26
# (TFLint unused-variable findings) because no resource consumes them yet.
# They remain reserved, documented design values in
# Dev_Environment_Terraform_Implementation_Plan.md Section 21 only.

# instance_type = "t3.medium" # already the default; uncomment to override
#   temporarily for a specific heavy session (allowed: t3.medium, t3.large,
#   t3.xlarge), then revert back to t3.medium once the session is over.

# ami_id_override = "<SPECIFIC_AMI_ID>" # leave commented out (null) to
#   always use the automatic latest-Amazon-Linux-2023-x86_64 lookup.

# additional_tags = {}
